{
  "manifest_version": 3,
  "name": "Endstep Tracker",
  "version": "0.9.1",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/mcouzinet/Endstep-Tracker",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://endstep.cc/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_action_title__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://endstep.cc/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://endstep.cc/*"
      ],
      "js": [
        "tracker.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
